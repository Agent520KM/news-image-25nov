// A delta-wing attack drone pointing along +x, turned by angle a.
const drone = (x, y, s = 1, a = 0) => `<g transform="translate(${x} ${y}) rotate(${a}) scale(${s})">
  <path d="M-5 0L4-1.3 5.2 0 4 1.3z M1-.5L-2-4.5H0L3.2-.5z M1 .5L-2 4.5H0L3.2 .5z" fill="#2b2f38"/><circle cx="4.4" r=".7" fill="#ff4b3e"/></g>`;
// An explosion: a spiky star in two colours.
const burst = (x, y, r) => {
  const pts = (rad) => Array.from({ length: 24 }, (_, i) => {
    const a = (i * Math.PI) / 12, k = i % 2 ? 0.5 : 1;
    return `${(x + Math.cos(a) * rad * k).toFixed(1)},${(y + Math.sin(a) * rad * k).toFixed(1)}`;
  }).join(" ");
  return `<polygon points="${pts(r)}" fill="#f08a24"/><polygon points="${pts(r * 0.6)}" fill="#ffd25a"/>`;
};
const person = (x, y, c, hat) => `<g fill="${c}"><circle cx="${x}" cy="${y - 6.4}" r="1.5"/>
  <path d="M${x - 1.7} ${y}v-4.2a1.7 1.7 0 0 1 3.4 0V${y}z"/>${hat ? `<path d="M${x - 1.8} ${y - 6.8}a1.8 1.8 0 0 1 3.6 0z" fill="${hat}"/>` : ""}</g>`;
// A grid of windows; `lit` lists which ones glow.
const windows = (x, y, cols, rows, lit = [], dark = "#1a2234") => {
  let s = "";
  for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
    const on = lit.includes(r * cols + c);
    s += `<rect x="${x + c * 3.2}" y="${y + r * 3.6}" width="1.8" height="2" fill="${on ? "#ffd25a" : dark}"/>`;
  }
  return s;
};
