  <path d="M0 0c-3.5 0-5-2.6-4.6-5.4.4-2.6 2.6-3.6 2.8-7.6 2 1.6 2.2 3.4 2 4.8 1-.6 1.6-2 1.8-3.4 2.4 2 3.4 4.4 3 6.6C4.6-2.2 3 0 0 0z" fill="#f08a24"/>
