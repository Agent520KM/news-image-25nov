    <path d="M47 33.5a2.6 2.6 0 0 1 5.2 0z" fill="#ffd25a"/>
    <path d="M75 16Q70 25 58 32" stroke="#e8e0c8" stroke-width=".8" fill="none"/>
    ${person(76, 22, "#2b3753", "#ffd25a")}${person(82, 22, "#2b3753", "#ffd25a")}${person(88, 22, "#c8382d", "#ffd25a")}
    <circle cx="8" cy="22" r="4" fill="#3f7f4a"/><circle cx="14" cy="21" r="3" fill="#4d9159"/>`,
  // 11: Pakistan's first astronaut rides a Chinese rocket to the Tiangong station.
  rocket: `<rect width="96" height="48" fill="#121b33"/>${stars([[6, 6], [18, 12], [30, 4], [60, 6], [70, 18], [90, 30], [12, 28], [52, 14]])}
    <ellipse cx="40" cy="74" rx="72" ry="32" fill="#2f6fa3"/><path d="M8 46Q20 42 30 45T52 44" fill="#3f8f5a"/>
    <path d="M30 46Q36 30 47 20" stroke="#fff" stroke-opacity=".45" stroke-width="2.4" fill="none"/>
    <path d="M50 18Q66 4 78 10" stroke="#ffd25a" stroke-width=".7" stroke-dasharray="1.6 1.6" fill="none"/>
    <g transform="translate(49 18) rotate(35)"><path d="M0-9c2.6 2 3.4 5.6 3.4 9L2 3H-2L-3.4 0c0-3.4.8-7 3.4-9z" fill="#f4f1ea"/>
      <rect x="-3.4" y="-2" width="6.8" height="1.6" fill="#c8382d"/><circle cy="-4" r="1.1" fill="#1f5fa8"/>
      <path d="M-3.2 0L-5.5 4H-2.2M3.2 0l2.3 4H2.2" fill="#c8382d"/>${flame(0, 8, 0.6).replace("translate(0 8)", "translate(0 8) rotate(180)")}</g>
    <g transform="translate(80 10)"><rect x="-5" y="-1.5" width="10" height="3" fill="#d9dde3"/><rect x="-1.5" y="-5" width="3" height="10" fill="#d9dde3"/>
      <rect x="-13" y="-3" width="7" height="6" fill="#1f5fa8"/><rect x="6" y="-3" width="7" height="6" fill="#1f5fa8"/></g>`,
  // 12: a Solomon Islands–Australia treaty rules out foreign military bases.
  treaty: `<rect width="96" height="48" fill="#9fd0e6"/>${waves(40)}${waves(45, 0.35)}
    <path d="M0 36Q12 22 30 36z" fill="#3f8f5a"/><path d="M16 27q-1-7 1-12" stroke="#7a5a35" stroke-width="1.1" fill="none"/>
    <path d="M17 15q-4-1-6 2M17 15q3-2 6 0M17 15q-1-3-5-3M17 15q2-3 5-2" stroke="#2f6b3c" stroke-width="1.3" fill="none"/>
    <path d="M70 36Q80 24 96 27V36z" fill="#d9a35b"/>
    <rect x="37" y="8" width="22" height="30" fill="#fbf4e2" stroke="#c9b98f" stroke-width=".8"/>
    <path d="M41 14h14M41 18h14M41 22h14M41 26h9" stroke="#b5a57d" stroke-width=".9"/>
    <path d="M51 33l-1.5 6 2.5-1.5 2.5 1.5-1.5-6" fill="#c8382d"/><circle cx="52.5" cy="32" r="3" fill="#c8382d"/>
    <g transform="translate(80 13)"><circle r="7" fill="#fff" stroke="#c8382d" stroke-width="1.6"/>
      <path d="M-3 4V-4M-3-4h5l-1 1.5 1 1.5h-5" stroke="#55606d" stroke-width="1" fill="#55606d"/><path d="M-5 5l10-10" stroke="#c8382d" stroke-width="1.6"/></g>`,
  // 13: Bangladesh's garment workers win a 36% pay offer after weeks of protest.
  shirt: `<rect width="96" height="48" fill="#f3e6da"/><rect y="40" width="96" height="8" fill="#cdbfae"/>
    <path d="M4 22l8-6v6l8-6v6l8-6v6l8-6v6V40H4z" fill="#b8bec8"/><rect x="30" y="8" width="3" height="10" fill="#9aa1ab"/>
    ${windows(7, 26, 8, 3, [], "#6f7885")}
    ${person(44, 40, "#1f5fa8")}${person(50, 40, "#c8382d")}${person(56, 40, "#2c7a5b")}${person(62, 40, "#e0a526")}
    <rect x="46" y="24" width="10" height="6" fill="#fff" stroke="#55606d" stroke-width=".6"/><path d="M51 30v4" stroke="#55606d" stroke-width=".6"/>
    <rect x="58" y="22" width="9" height="6" fill="#fff" stroke="#55606d" stroke-width=".6"/><path d="M62.5 28v6" stroke="#55606d" stroke-width=".6"/>
    <path d="M86 38V14M80 20l6-7 6 7" stroke="#2c7a5b" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="79" y="32" text-anchor="end" font-size="9" font-weight="900" fill="#2c7a5b" ${FONT}>36%</text>`,
};
for (const el of document.querySelectorAll(".ico")) {
  el.innerHTML = `<svg viewBox="0 0 96 48" preserveAspectRatio="xMidYMid slice">${SCENES[el.dataset.i]}</svg>`;
}

// Every story gets a category, shown in that category's colour, and the kind of source
// behind it: "off" is an on-record statement from a government, court, military or agency,
// or official data; "rep" is a press report, unnamed sources, an NGO or a poll.
const COLOURS = {
  Conflict: "#c8382d", Security: "#7b3fa0", Economy: "#1f5fa8", Politics: "#0f7c86",
  Justice: "#8a5a2b", Disaster: "#d9731a", Space: "#3446a8", Diplomacy: "#2c7a5b",
  Energy: "#b38600", Health: "#c2407a", Climate: "#4f8a1f", Migration: "#5b6472", Sport: "#3d8fc4",
};
const META = {
  1: ["Conflict", "off"], 2: ["Conflict", "off"], 3: ["Economy", "off"], 4: ["Conflict", "off"],
  5: ["Conflict", "off"], 6: ["Conflict", "rep"], 7: ["Economy", "off"], 8: ["Economy", "off"],
  9: ["Conflict", "off"], 10: ["Disaster", "off"], 11: ["Space", "off"], 12: ["Diplomacy", "off"],
  13: ["Economy", "off"], 14: ["Conflict", "off"], 15: ["Justice", "off"], 16: ["Security", "off"],
  17: ["Politics", "off"], 18: ["Economy", "off"], 19: ["Economy", "off"], 20: ["Politics", "rep"],
  21: ["Justice", "off"], 22: ["Energy", "off"], 23: ["Migration", "off"], 24: ["Security", "rep"],
  25: ["Politics", "off"], 26: ["Climate", "off"], 27: ["Economy", "off"], 28: ["Economy", "off"],
  29: ["Sport", "off"],
};
// The colour carries the category; the category's name joins the story's place line,
// and only stories resting on a report get a quiet "(report)" mark.
for (const el of document.querySelectorAll("[data-n]")) {
  const [cat, src] = META[el.dataset.n];
  el.style.setProperty("--c", COLOURS[cat]);
  const mark = src === "rep" ? ` <i class="rep">(report)</i>` : "";
  const line = el.querySelector(".tag") || el.querySelector("small");
  line.insertAdjacentHTML("beforeend", ` · ${cat}${mark}`);
}

// The row under the header: a bar split by region, each part as wide as its share of stories
// (plus a small fixed width so the smallest regions can still hold their names).
const counts = Object.fromEntries(REGION_ORDER.map((r) => [r, 0]));
for (const p of PLACES) counts[p[3]]++;
const SHADES = ["#101826", "#2b3a55", "#46597a", "#62769a", "#8798b4", "#b0bccf"];
document.getElementById("where").innerHTML = `<span class="lbl2">Where the ${PLACES.length} stories happened</span><div class="bar">` +
  REGION_ORDER.map((r, i) => `<span class="seg" style="flex:${counts[r] + 1.5};background:${SHADES[i]}${i > 3 ? ";color:#101826" : ""}"><b>${counts[r]}</b>${r}</span>`).join("") + `</div>`;
const byCat = {};
for (const [cat] of Object.values(META)) byCat[cat] = (byCat[cat] || 0) + 1;
// The row at the foot: what each colour means, and how many stories carry it.
document.getElementById("what").innerHTML = `<span class="lbl2">Colour key</span>` +
  Object.keys(COLOURS).filter((c) => byCat[c]).sort((a, b) => byCat[b] - byCat[a])
    .map((c) => `<span><i style="background:${COLOURS[c]}"></i>${c}<b>${byCat[c]}</b></span>`).join("");

// One pin per story, on its place, in its category's colour.
for (const [n, lon, lat, , nx = 0, ny = 0] of PLACES) {
  const [x0, y0] = px(lon, lat);
  const x = x0 + nx, y = y0 + ny;
  add("circle", { cx: x, cy: y, r: 5.4, fill: COLOURS[META[n][0]], stroke: "#fff", "stroke-width": 1.1 });
  const t = add("text", { x, y: y + 2.4, "text-anchor": "middle", "font-size": 6.8, "font-weight": 800, fill: "#fff", "font-family": "Helvetica Neue, Arial, sans-serif" });
  t.textContent = n;
}
</script>
</body>
</html>
