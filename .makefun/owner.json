const svg = document.getElementById("world");
const NS = "http://www.w3.org/2000/svg";
const add = (tag, attrs) => {
  const el = document.createElementNS(NS, tag);
  for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
  svg.appendChild(el);
  return el;
};
const pathOf = (ring) => "M" + ring.map(([lo, la]) => px(lo, la).map((n) => n.toFixed(1)).join(",")).join("L") + "Z";

// Graticule every 30 degrees.
for (let lon = -90; lon <= 150; lon += 30) {
  const [x] = px(lon, 0);
  add("line", { x1: x, y1: 0, x2: x, y2: H, stroke: "#c6d4df", "stroke-width": 1 });
}
for (let lat = -30; lat <= 60; lat += 30) {
  const [, y] = px(0, lat);
  add("line", { x1: 0, y1: y, x2: W, y2: y, stroke: "#c6d4df", "stroke-width": 1 });
}
for (const ring of LAND) add("path", { d: pathOf(ring), fill: "#cfc6b2", stroke: "#a99f88", "stroke-width": 1 });
for (const ring of WATER) add("path", { d: pathOf(ring), fill: "#dbe6ee", stroke: "#a99f88", "stroke-width": 1 });

